<Window x:Class="ScreenWriter.Windows.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Left="0" Top="0"
        Icon="pack://application:,,,/ScreenWriter;component/Assets/icon.ico"
        Title="Screen Writer Toolbar"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.BitmapScalingMode="HighQuality"
        MouseEnter="Toolbar_MouseEnter"
        MouseLeave="Toolbar_MouseLeave">

    <Window.Resources>
        <Style x:Key="ColorBtn" TargetType="Button">
            <Setter Property="Width"           Value="22"/>
            <Setter Property="Height"          Value="22"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Width="18" Height="18"
                                 Fill="{TemplateBinding Background}"
                                 Stroke="{TemplateBinding BorderBrush}"
                                 StrokeThickness="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Height"          Value="30"/>
            <Setter Property="MinWidth"        Value="30"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Padding"         Value="4,0"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- عنصر في قائمة السبورة -->
        <Style x:Key="BoardItem" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="ToolbarBorder" Background="#E0111827" CornerRadius="0,0,12,0" Padding="10,7">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- تفعيل/إيقاف -->
            <Button x:Name="BtnToggleMode" Style="{StaticResource ToolBtn}" Padding="8,0"
                    Click="BtnToggleMode_Click"
                    ToolTip="{DynamicResource Str_ToggleMode}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ModeIndicator" Width="8" Height="8" Fill="#555555" Margin="0,0,5,0"/>
                    <TextBlock x:Name="ModeText"
                               Text="{DynamicResource Str_ModeInactive}"
                               FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- وضع السبورة: شفاف / أبيض / أسود -->
            <Button x:Name="BtnBoard" Style="{StaticResource ToolBtn}" Padding="6,0"
                    Click="BtnBoard_Click"
                    ToolTip="{DynamicResource Str_Board}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="BoardIcon" Width="18" Height="14" CornerRadius="2"
                            BorderBrush="#CCCCCC" BorderThickness="1.5" Background="Transparent"/>
                    <TextBlock Text="▾" Foreground="#CCCCCC" FontSize="11"
                               VerticalAlignment="Center" Margin="3,0,0,0"/>
                </StackPanel>
            </Button>

            <Popup x:Name="BoardPopup"
                   PlacementTarget="{Binding ElementName=BtnBoard}"
                   Placement="Bottom" VerticalOffset="4"
                   StaysOpen="False" AllowsTransparency="True"
                   PopupAnimation="Fade"
                   Opened="BoardPopup_Opened" Closed="BoardPopup_Closed">
                <Border Background="#F2111827" CornerRadius="8" Padding="4"
                        BorderBrush="#44FFFFFF" BorderThickness="1">
                    <StackPanel x:Name="BoardMenu" MinWidth="190">
                        <Button x:Name="BoardItemTransparent" Style="{StaticResource BoardItem}"
                                Tag="Transparent" Click="BoardItem_Click">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="BoardCheckTransparent" DockPanel.Dock="Left" Width="16"
                                           Text="✓" Foreground="#06D6A0" FontSize="12"/>
                                <Border DockPanel.Dock="Left" Width="16" Height="12" CornerRadius="2"
                                        BorderBrush="#CCCCCC" BorderThickness="1.5" Margin="0,0,8,0"/>
                                <TextBlock DockPanel.Dock="Right" Text="Ctrl+Alt+T"
                                           Foreground="#777777" FontSize="11" Margin="12,0,0,0"
                                           FlowDirection="LeftToRight"/>
                                <TextBlock Text="{DynamicResource Str_BoardTransparent}"
                                           Foreground="#E5E7EB" FontSize="12"/>
                            </DockPanel>
                        </Button>
                        <Button x:Name="BoardItemWhite" Style="{StaticResource BoardItem}"
                                Tag="White" Click="BoardItem_Click">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="BoardCheckWhite" DockPanel.Dock="Left" Width="16"
                                           Text="✓" Foreground="#06D6A0" FontSize="12"/>
                                <Border DockPanel.Dock="Left" Width="16" Height="12" CornerRadius="2"
                                        Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                                        Margin="0,0,8,0"/>
                                <TextBlock DockPanel.Dock="Right" Text="Ctrl+Alt+W"
                                           Foreground="#777777" FontSize="11" Margin="12,0,0,0"
                                           FlowDirection="LeftToRight"/>
                                <TextBlock Text="{DynamicResource Str_BoardWhite}"
                                           Foreground="#E5E7EB" FontSize="12"/>
                            </DockPanel>
                        </Button>
                        <Button x:Name="BoardItemBlack" Style="{StaticResource BoardItem}"
                                Tag="Black" Click="BoardItem_Click">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="BoardCheckBlack" DockPanel.Dock="Left" Width="16"
                                           Text="✓" Foreground="#06D6A0" FontSize="12"/>
                                <Border DockPanel.Dock="Left" Width="16" Height="12" CornerRadius="2"
                                        Background="#121212" BorderBrush="#CCCCCC" BorderThickness="1"
                                        Margin="0,0,8,0"/>
                                <TextBlock DockPanel.Dock="Right" Text="Ctrl+Alt+B"
                                           Foreground="#777777" FontSize="11" Margin="12,0,0,0"
                                           FlowDirection="LeftToRight"/>
                                <TextBlock Text="{DynamicResource Str_BoardBlack}"
                                           Foreground="#E5E7EB" FontSize="12"/>
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <Rectangle Width="1" Height="26" Fill="#44FFFFFF" Margin="6,0"/>

            <!-- ألوان -->
            <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Background="#E63946" Style="{StaticResource ColorBtn}" Tag="#E63946" Click="ColorBtn_Click" ToolTip="{DynamicResource Str_Red}"/>
                <Button Background="#F4A261" Style="{StaticResource ColorBtn}" Tag="#F4A261" Click="ColorBtn_Click" ToolTip="{DynamicResource Str_Orange}"/>
                <Button Background="#FFD166" Style="{StaticResource ColorBtn}" Tag="#FFD166" Click="ColorBtn_Click" ToolTip="{DynamicResource Str_Yellow}"/>
                <Button Background="#06D6A0" Style="{StaticResource ColorBtn}" Tag="#06D6A0" Click="ColorBtn_Click" ToolTip="{DynamicResource Str_Green}"/>
                <Button Background="#118AB2" Style="{StaticResource ColorBtn}" Tag="#118AB2" Click="ColorBtn_Click" ToolTip="{DynamicResource Str_Blue}"/>
                <Button Background="#8338EC" Style="{StaticResource ColorBtn}" Tag="#8338EC" Click="ColorBtn_Click" ToolTip="{DynamicResource Str_Purple}"/>
                <Button Background="#FFFFFF" Style="{StaticResource ColorBtn}" Tag="#FFFFFF" Click="ColorBtn_Click" ToolTip="{DynamicResource Str_White}"/>
                <Button Background="#111111" Style="{StaticResource ColorBtn}" Tag="#111111" Click="ColorBtn_Click" ToolTip="{DynamicResource Str_Black}"/>
            </StackPanel>

            <Rectangle Width="1" Height="26" Fill="#44FFFFFF" Margin="6,0"/>

            <!-- حجم القلم -->
            <TextBlock Text="✏" Foreground="#888" FontSize="13"
                       VerticalAlignment="Center" Margin="0,0,4,0"/>
            <Slider x:Name="SizeSlider" Width="65" Minimum="2" Maximum="30" Value="4"
                    VerticalAlignment="Center" ValueChanged="SizeSlider_ValueChanged"/>

            <Rectangle Width="1" Height="26" Fill="#44FFFFFF" Margin="6,0"/>

            <!-- أدوات الرسم -->
            <Button x:Name="BtnPen"     Style="{StaticResource ToolBtn}" Click="BtnPen_Click"     ToolTip="{DynamicResource Str_ToolPen}">
                <Image Source="/Assets/Icons/pen.png"     Width="18" Height="18"/>
            </Button>
            <Button x:Name="BtnArrow"   Style="{StaticResource ToolBtn}" Click="BtnArrow_Click"   ToolTip="{DynamicResource Str_ToolArrow}">
                <Image Source="/Assets/Icons/arrow.png"   Width="18" Height="18"/>
            </Button>
            <Button x:Name="BtnLine"    Style="{StaticResource ToolBtn}" Click="BtnLine_Click"    ToolTip="{DynamicResource Str_ToolLine}">
                <Image Source="/Assets/Icons/line.png"    Width="18" Height="18"/>
            </Button>
            <Button x:Name="BtnRect"    Style="{StaticResource ToolBtn}" Click="BtnRect_Click"    ToolTip="{DynamicResource Str_ToolRect}">
                <Image Source="/Assets/Icons/rect.png"    Width="18" Height="18"/>
            </Button>
            <Button x:Name="BtnEllipse" Style="{StaticResource ToolBtn}" Click="BtnEllipse_Click" ToolTip="{DynamicResource Str_ToolEllipse}">
                <Image Source="/Assets/Icons/ellipse.png" Width="18" Height="18"/>
            </Button>
            <Button x:Name="BtnText"    Style="{StaticResource ToolBtn}" Click="BtnText_Click"    ToolTip="{DynamicResource Str_ToolText}">
                <Image Source="/Assets/Icons/text.png"    Width="18" Height="18"/>
            </Button>
            <Button x:Name="BtnSelect"  Style="{StaticResource ToolBtn}" Click="BtnSelect_Click"  ToolTip="{DynamicResource Str_ToolSelect}">
                <Image Source="/Assets/Icons/select.png"  Width="18" Height="18"/>
            </Button>
            <Button x:Name="BtnEraser"  Style="{StaticResource ToolBtn}" Click="BtnEraser_Click"  ToolTip="{DynamicResource Str_ToolEraser}">
                <Image Source="/Assets/Icons/eraser.png"  Width="18" Height="18"/>
            </Button>

            <Rectangle Width="1" Height="26" Fill="#44FFFFFF" Margin="6,0"/>

            <!-- تراجع / إعادة / مسح -->
            <Button Style="{StaticResource ToolBtn}" Click="BtnUndo_Click"  ToolTip="{DynamicResource Str_Undo}">
                <Image Source="/Assets/Icons/undo.png"  Width="18" Height="18"/>
            </Button>
            <Button Style="{StaticResource ToolBtn}" Click="BtnRedo_Click"  ToolTip="{DynamicResource Str_Redo}">
                <Image Source="/Assets/Icons/redo.png"  Width="18" Height="18"/>
            </Button>
            <Button Style="{StaticResource ToolBtn}" Click="BtnClear_Click" ToolTip="{DynamicResource Str_ClearAll}">
                <Image Source="/Assets/Icons/trash.png" Width="18" Height="18"/>
            </Button>

            <Rectangle Width="1" Height="26" Fill="#44FFFFFF" Margin="6,0"/>

            <!-- عن البرنامج -->
            <Button Style="{StaticResource ToolBtn}" Click="BtnAbout_Click"
                    ToolTip="{DynamicResource Str_About}" Padding="6,0">
                <Image Source="/Assets/Icons/info.png" Width="18" Height="18"/>
            </Button>

            <!-- تبديل موضع الشريط -->
            <Button x:Name="BtnPosition" Style="{StaticResource ToolBtn}"
                    Click="BtnPosition_Click"
                    ToolTip="{DynamicResource Str_TogglePosition}" Padding="4,0">
                <Image Source="/Assets/Icons/swap.png" Width="18" Height="18"/>
            </Button>

            <!-- تبديل اللغة -->
            <Button x:Name="BtnLang"
                    Content="{DynamicResource Str_LangToggle}"
                    Style="{StaticResource ToolBtn}"
                    Click="BtnLang_Click"
                    Foreground="#FFD166" Padding="6,0"
                    FontSize="11" FontWeight="Bold"/>

            <!-- إغلاق -->
            <Button Content="✕" Style="{StaticResource ToolBtn}" Click="BtnClose_Click"
                    Foreground="#FF6B6B" ToolTip="{DynamicResource Str_Close}" Padding="6,0"/>

        </StackPanel>
    </Border>
</Window>
