<Window x:Class="ScreenWriter.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Title="ScreenWriter Overlay">
    <!-- One InkCanvas per board mode; only the active one is visible. -->
    <Grid>
        <InkCanvas x:Name="ScreenCanvas"
                   Background="#01000000"
                   EditingMode="None"
                   UseCustomCursor="True"/>
        <InkCanvas x:Name="WhiteCanvas"
                   Background="White"
                   EditingMode="None"
                   UseCustomCursor="True"
                   Visibility="Collapsed"/>
        <InkCanvas x:Name="BlackCanvas"
                   Background="#121212"
                   EditingMode="None"
                   UseCustomCursor="True"
                   Visibility="Collapsed"/>
    </Grid>
</Window>
